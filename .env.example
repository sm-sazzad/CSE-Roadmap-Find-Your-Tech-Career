# ==========================================
# Database Connection (MongoDB Atlas)
# ==========================================
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Cse_Roadmap?retryWrites=true&w=majority

# ==========================================
# Better Auth Configuration
# ==========================================
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_random_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# ==========================================
# OAuth Providers (Optional for local dev)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# Google Gemini AI Chatbot
# Get key from: https://aistudio.google.com/
# ==========================================
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Email Configuration (Nodemailer - Optional)
# ==========================================
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@cse-roadmap.com
